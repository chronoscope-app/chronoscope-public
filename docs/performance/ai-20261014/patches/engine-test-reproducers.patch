+use chronoscope::{model::*,store::DataStore,engine::Engine,project::Project}; use serde_json::json;
+#[test] fn direct_predicates_match_domain_unicode_missing_numeric_whitespace(){let d=tempfile::tempdir().unwrap();let mut s=DataStore::new(d.path()).unwrap();let mut events=chronoscope::demo::dataset().events;for (i,e) in events.iter_mut().enumerate(){e.category=if i%2==0{"Évidence"}else{""}.into();e.value=match i%4{0=>None,1=>Some(0.),2=>Some(-2.5),_=>Some(10.)};e.attrs.insert("number".into(),if i%2==0{" 10 "}else{"banana"}.into());}s.load_events(events.clone()).unwrap();for field in ["category","entity","source","id","value","lat","lon","attribute:number"]{for op in [Operator::Equals,Operator::NotEquals,Operator::Greater,Operator::Less,Operator::Contains,Operator::IsEmpty]{for value in ["", "Évidence","évidence","10","1e1"," 10 ","NaN","-0","-2.5"]{if field=="attribute:number" && matches!(op,Operator::Greater|Operator::Less) && value.parse::<f64>().ok().filter(|v|v.is_finite()).is_none(){continue;}let f=Filter{predicates:vec![Predicate{field:field.into(),op:op.clone(),value:value.into()}],..Default::default()};let t=s.ordered(&f,None,"id",false).unwrap();let mut expected:Vec<_>=events.iter().filter(|e|f.matches(e,&Default::default())).map(|e|e.id).collect();expected.sort_unstable();assert_eq!(s.ids(&t).unwrap(),expected,"{field} {op:?} {value}");}}}}
+#[test] fn compact_then_full_snapshot_matches_full_projection(){let d=tempfile::tempdir().unwrap();let e=Engine::new(Project::new(chronoscope::demo::dataset()),d.path().into()).unwrap();let c=e.invoke("snapshot",json!({"compact":true})).unwrap();let mut f=e.invoke("snapshot",json!({})).unwrap();assert_eq!(f["histogram"].as_array().unwrap().iter().map(|v|v.as_u64().unwrap()).sum::<u64>(),192);for k in ["histogram","selected_histogram","views","groups","workspace","imports"]{f.as_object_mut().unwrap().remove(k);}assert_eq!(c,f);}
