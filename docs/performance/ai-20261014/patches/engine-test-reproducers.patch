+use chronoscope::{engine::Engine,project::Project,operation};use serde_json::json;use std::sync::{Arc,atomic::AtomicBool,mpsc};use std::time::Instant;
+#[test]fn job_status_cancel_bypass_occupied_workspace_gate(){let d=tempfile::tempdir().unwrap();let e=Engine::new(Project::new(chronoscope::demo::dataset()),d.path().into()).unwrap();let (entered,wait)=mpsc::channel();let (release,released)=mpsc::channel();let released=Arc::new(std::sync::Mutex::new(released));let worker=e.clone();let handle=std::thread::spawn(move||operation::with_context(operation::Context{cancelled:Arc::new(AtomicBool::new(false)),scope:None,progress:Some(Arc::new(move|_,_,message|{if message=="Running"{entered.send(()).unwrap();released.lock().unwrap().recv().unwrap();}}))},||worker.invoke("query",json!({"limit":1}))));wait.recv().unwrap();let j=e.invoke("job_start",json!({"command":"query","arguments":{"limit":1}})).unwrap();let start=Instant::now();let status=e.invoke("job_status",json!({"job_id":j["job_id"]})).unwrap();let status_ms=start.elapsed().as_secs_f64()*1000.;let start=Instant::now();e.invoke("job_cancel",json!({"job_id":j["job_id"]})).unwrap();let cancel_ms=start.elapsed().as_secs_f64()*1000.;let (done,completion)=mpsc::channel();let other=e.clone();let query=std::thread::spawn(move||{let t=Instant::now();let r=other.invoke("revision",json!({}));done.send((r,t.elapsed().as_secs_f64()*1000.)).unwrap();});assert!(completion.try_recv().is_err());release.send(()).unwrap();handle.join().unwrap().unwrap();let (r,queue_ms)=completion.recv().unwrap();r.unwrap();query.join().unwrap();eprintln!("GATE_RESPONSE status_ms={status_ms} cancel_ms={cancel_ms} state_query_wait_ms={queue_ms} status={status}");}
